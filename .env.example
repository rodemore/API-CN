# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/ruleta

# Server Configuration
PORT=3000
NODE_ENV=development

# Game Probabilities Configuration
# Probability for Roulette (ID_RULETA: 1) - 80% chance to win
ROULETTE_PROBABILITY=0.80

# Probability for Domino (ID_RULETA: 2) - 45% chance to win
DOMINO_PROBABILITY=0.45

# Probability for Cyber (ID_RULETA: 3) - 0.21% chance to win (516 prizes / 250k plays)
CYBER_PROBABILITY=0.002064

# Probability for Album (ID_RULETA: 4) - 100% chance to win (always wins)
ALBUM_PROBABILITY=1.0

# Probability for Milex (ID_RULETA: 6) - 60% chance to win
MILEX_PROBABILITY=0.60
